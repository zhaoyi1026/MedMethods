# --- imports ----------------------------------------------------------------
# Resolved for the method modules, which are sourced into private environments
# whose parent is this namespace (see R/zzz.R).

importFrom("MASS", "ginv")

# VarCorr and ranef are the shared nlme generics that lme4 re-exports; the
# merMod methods are registered by lme4, which is attached via lmer below.
